# --- this bot's own identity ---
DBOT_TOKEN=123456:ABC-your-downloaderbot-token
DBOT_USERNAME=YourDownloaderBotUsername

# Your own numeric Telegram user id(s) (not username), comma-separated if
# you use more than one account -- gates the owner-only /messageas, /dbdump
# and /status admin commands. Leave blank to disable them. Get your id from
# e.g. @userinfobot.
DBOT_ADMIN_ID=

# --- the shared family database ---
# ONE Postgres for the whole family, one schema per bot. Everything that
# binds a bot to a place is this single line: point it at the cloud and the
# bot runs in the cloud, point it back at localhost and it runs here.
#
# Supabase (the family's cloud database). Copy the SESSION POOLER string
# from Project Settings -> Database -- the one on port 5432:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
#   NOT the transaction pooler on port 6543. This bot passes its
#   search_path as a connection option, and transaction pooling throws
#   per-connection options away between transactions -- the bot would read
#   and write "public" instead of its own schema and go on heartbeating as
#   if nothing were wrong. db.py warns at startup if it sees port 6543.
#
#   NOT the direct connection (db.<ref>.supabase.co) either, unless you
#   know you have IPv6: Supabase made that one IPv6-only.
#
#   PERCENT-ENCODE the password if it contains @ : / ? # or a space
#   (@ -> %40, : -> %3A, / -> %2F, # -> %23, space -> %20). An unencoded
#   "@" splits the URL in the wrong place, and the error you get names a
#   hostname you have never heard of instead of saying "bad password".
#   And if it contains "#", quote the whole value here -- python-dotenv
#   treats an unquoted # as the start of a comment.
#
# Local dev: docker compose up -d in the REPO ROOT (one Postgres for the
# whole family), or in this folder for a standalone one.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/botfamily
#
# Only run a given bot in ONE place at a time. Two processes polling
# getUpdates with the same token means Telegram answers one of them with
# 409 Conflict; stop it here before you start it there.

# This bot's own schema inside that shared database. The whole family shares
# one database with one schema per bot, so the four bots' identically-named
# tables (user_settings, star_transactions, ...) never collide. Leave it
# unset only if you are running this bot against a database of its own.
DB_SCHEMA=downloader_bot

# The other end, for db_backup.ps1 / family_db.py when they move data
# between two databases. Same session-pooler string as above when the cloud
# copy is Supabase.
# CLOUD_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# The post-download ConvertBot pointer is driven by this -- no file is
# actually handed over (no file handover between the two processes), the user
# just re-sends it there.
SIBLING_BOTS=stickerbot:StickerBot:YourStickerBotUsername,convertbot:ConvertBot:YourConvertBotUsername,downloaderbot:DownloaderBot:YourDownloaderBotUsername,anonbot:AnonBot:YourAnonBotUsername

# --- optional: let /donate accept USD as well as Telegram Stars ---
#
# READ THIS BEFORE SETTING IT. Leaving it blank is the recommended state and
# is why /donate currently shows one column of buttons rather than two: the
# fiat column is drawn only for currencies that have a provider token, so an
# empty value here is not a bug, it is the feature working.
#
# Stars need no provider, no merchant account, no KYC and no country
# support, and they are the rail Telegram itself expects for anything
# digital -- a bot selling a digital good or taking a voluntary contribution
# is Stars territory, and provider payments are aimed at physical goods and
# real-world services. Stars also work for every user in every country,
# which a card provider does not.
#
# What Stars cost you is the way out: Stars -> TON via Fragment (with a
# holding period) -> sell. That is several hops, and it is the honest reason
# to want a card provider instead.
#
# If you do want one: @BotFather -> /mypayments -> Connect, pick a provider
# that supports payouts to YOUR country -- that is the constraint that
# decides this, not the bot -- and paste the token it gives you here. Check
# the provider's own cut against the tier amounts in shared_features.py's
# FIAT_CURRENCIES first: at the $1 tier a percentage-plus-fixed fee can take
# most of the donation, which is why that column starts at $1 and not at the
# Stars column's equivalent of $0.30.
#
# Nothing changes until this is set. With it set, /donate grows a second
# column and `/donate 5 usd` starts working.
PAYMENT_PROVIDER_TOKEN_USD=

# --- the donation nudge ---
# Usage-based and finite: shown after 15 successful actions, then 60 more,
# then 200 more, then never again -- and never at all to anyone who has
# already donated. See the block above DONATION_STEPS in shared_features.py
# for why the old "or every 14 days" half was removed.
#
# Off by default: pin the nudge in the chat instead of leaving it in the
# scroll. It reads well in theory ("ask once, stay visible") and less well in
# practice -- a pin is a permanent claim on the top of someone's chat for
# something explicitly voluntary, it posts a "pinned a message" service line
# of its own, and it argues with anything the bot might later want to pin for
# a real reason. With the schedule above capping the ask at three times ever,
# there is not much left for it to solve. Turn it on with `on` if you
# disagree; it pins silently and unpins for good the moment that person
# donates.
# DONATION_PIN=off



# ---------------------------------------------------------------------------
# Running cost. Every value below has a sensible default -- this block exists
# so you know which dials there are, not because anything needs setting.
# ---------------------------------------------------------------------------

# --- the database connection pool ---
# One warm connection is held open and handed to every query; more are opened
# only while several things happen at once, and handed back after
# DB_POOL_MAX_IDLE seconds. Raising DB_POOL_MAX costs the database one
# reserved backend (and its memory) per connection, so leave it low unless
# this bot is genuinely busy.
# DB_POOL_MIN=1
# DB_POOL_MAX=3
# DB_POOL_MAX_IDLE=120
# DB_POOL_TIMEOUT=15
#
# How long a pooled connection may sit unused before it is worth a round trip
# proving it is still alive on checkout. This check used to run on EVERY
# checkout, including one half a second after the last -- a whole round trip
# to the database, which on a link to another continent was a third of the
# cost of every read. Lower it if a network in between drops idle
# connections faster than this; 0 checks every time, as it used to.
# DB_POOL_CHECK_AFTER_IDLE=45

# --- Telegram long polling ---
# Seconds to hold each getUpdates open. Higher is *cheaper*, not slower:
# Telegram answers the instant an update exists, so a longer window means
# fewer HTTP requests for identical latency. 30 is comfortably inside every
# proxy's idle timeout.
# POLL_TIMEOUT=30

# --- worker threads ---
# The pool that blocking work (database calls, ffmpeg, image processing) runs
# on. Python's default sizes itself to the *host's* core count, which on a
# shared cloud host is far more than this container's share.
# WORKER_THREADS=4

# --- active-user counting ---
# /status counts distinct users over a window, so recording each user once per
# flush window is exactly as accurate as recording every update, and writes a
# fraction as much. Rows older than the retention window are pruned by the
# housekeeping job -- they cost storage and answer nothing.
# ACTIVITY_FLUSH_SECONDS=60
# ACTIVITY_RETENTION_DAYS=90

# --- in-memory per-user state ---
# python-telegram-bot never evicts its per-user cache. Anyone idle this long
# has theirs dropped; the only thing lost is a cached language, re-read from
# the database on their next message.
# USER_DATA_TTL_HOURS=12

# --- logging ---
# Rotating bot.log/errors.log files next to bot.py. On by default locally,
# off by default on Railway -- there the filesystem is ephemeral and the
# platform already captures stdout, so the files are pure disk churn.
# LOG_TO_FILES=1

# --- the family bus (see family_link.py) ---
# FAMILY_BUS=off drops this bot back to standalone: no heartbeats, no
# ParentBot, no remote commands. Useful for isolating a problem, not as a
# permanent setting.
# FAMILY_BUS=on
# FAMILY_HEARTBEAT_SECONDS=30
# The command queue is polled, fast right after the bus was last busy
# and slow once it has gone quiet -- see family_link.py. Lower idle =
# snappier /run and /ping when nothing else is going on, at a few more
# background queries a minute.
# FAMILY_BUS_POLL_ACTIVE_SECONDS=1
# FAMILY_BUS_POLL_IDLE_SECONDS=10
# FAMILY_BUS_ACTIVE_WINDOW_SECONDS=20
# How often this bot deletes its own finished rows from the shared tables,
# and how long they are kept. family.commands carries file payloads, so this
# is the difference between a database that grows forever and one that
# doesn't.
# FAMILY_HOUSEKEEPING_SECONDS=21600
# FAMILY_COMMAND_RETENTION_HOURS=24
# FAMILY_EVENT_RETENTION_DAYS=30

# --- downloads ---
# This is the bot with real resource spikes -- yt-dlp, ffmpeg and an upload,
# all at once. The concurrency limit is what stops ten pasted links in the
# same minute from becoming ten simultaneous downloads on a container sized
# for one. The size/duration ceilings stop a mis-pasted link to a three-hour
# stream before the first byte is fetched.
# DBOT_MAX_CONCURRENT_DOWNLOADS=2
# DBOT_MAX_DOWNLOAD_MB=48
# DBOT_MAX_DURATION_SECONDS=1800
# DBOT_SOCKET_TIMEOUT=30

# --- one person's share of the day ---
# The concurrency limit above protects the container; it is not a share of
# it. Two global slots held all afternoon by one person pasting a playlist
# leaves everybody else queueing behind a stranger, and the bot looks broken
# to people who did nothing wrong. These are rolling windows, counted per
# person in the database so a redeploy does not hand the heaviest user a
# fresh allowance (which would be several a day when anything is being
# worked on). 0 on either turns that window off.
# DBOT_DOWNLOADS_PER_HOUR=12
# DBOT_DOWNLOADS_PER_DAY=40
#
# What both ceilings are multiplied by for anyone who has ever donated --
# any amount, once, forever. The honest version of paying for something
# whose cost is a fetch and an encode; billing monthly for this would cost
# more to run than it collects.
# DBOT_DONOR_MULTIPLIER=4
#
# How long the per-download rows are kept. The quota only ever looks back a
# day; the rest is so the owner can answer "was that person really hammering
# it on Tuesday".
# DBOT_DOWNLOAD_RETENTION_DAYS=7

# --- the download routes (resolvers.py) ---
# Since v1.2.1 a link is not fetched one way. Each platform has a chain of
# independent routes -- downloadgram and InstaFix for Instagram, tikwm and
# tnktok for TikTok, vxtwitter and fxtwitter for X, and yt-dlp last in every
# one -- tried in order until something produces media. The bot keeps score
# per route in its own `provider_health` table, moves a route that keeps
# failing to the back of its chain, and retries it more and more rarely
# instead of taking it out of service. `/providers` (owner-only) shows the
# current state; `python probe.py` asks every route from wherever you run it.
#
# Nothing below needs setting for that to work. These are the knobs.
#
# How long one route gets before the chain moves on. Short on purpose: four
# routes at twenty seconds is still inside what a user will wait, and waiting
# out a dead service costs more than trying the next one.
# DBOT_PROVIDER_TIMEOUT=20
# How many failures in a row before a route starts being skipped, and the
# backoff it is skipped for (doubling, capped).
# DBOT_PROVIDER_COOLDOWN_AFTER=3
# DBOT_PROVIDER_COOLDOWN_BASE=120
# DBOT_PROVIDER_COOLDOWN_MAX=3600
# How often the scores are written to Postgres. They are advice, not user
# data, so they are batched rather than written per download.
# DBOT_PROVIDER_FLUSH_SECONDS=60
# How long one route gets during a probe (`/run downloaderbot probe`),
# as opposed to a real download. Shorter, because ParentBot calls a
# family command failed after 90 seconds.
# DBOT_PROBE_TIMEOUT=12
# Which InstaFix instance to use. Its two better-known domains (ddinstagram,
# kkinstagram) both stopped resolving, which is most of the argument for
# having a chain at all -- so this is a variable rather than a constant.
# DBOT_INSTAFIX_HOST=https://eeinstagram.com
# Where downloads are staged before being uploaded to Telegram. Defaults to
# the system temp directory; set it if the container's /tmp is small.
# DBOT_WORK_DIR=
# HTTP timeouts for the direct media fetches (yt-dlp has its own, above).
# DBOT_CONNECT_TIMEOUT=10
# DBOT_READ_TIMEOUT=30

# --- getting past a site that will not serve a server ---
# The chain above exists because of this, so it is worth understanding even
# though it now needs no action.
#
# Instagram and YouTube decide what to hand back partly from WHERE the
# request comes from, and every cloud host's address is a known datacenter
# range. From a phone the same link is public; from here it is a login page.
#
# The routes in resolvers.py sidestep that by not making the request from
# here at all: those services fetch on their own infrastructure and hand back
# either a direct CDN link or a copy proxied through themselves. yt-dlp is
# the one route that still goes out from this container, which is why it is
# last in every chain -- and why the two settings below still matter. They
# are the only thing that makes yt-dlp work from a datacenter, and yt-dlp is
# the only route YouTube has at all.
#
# Two mitigations, combinable, neither free:
#
#   COOKIES -- a cookies.txt exported from a browser logged into that site.
#   Cheapest to try and the quickest to stop working: the session expires in
#   days to weeks, a session used from a datacenter IP is exactly what these
#   sites look for, and the account can be restricted for it. Use a THROWAWAY
#   account, never your own. Export with a "Get cookies.txt" browser
#   extension, in Netscape format, and mount/commit the file somewhere the
#   container can read.
#
#   PROXY -- send the request out through a residential or mobile address.
#   Costs money and is the one that actually holds, because it fixes the
#   thing being objected to rather than arguing with it. Any http/https/socks5
#   URL yt-dlp accepts, credentials included.
#
# The per-site variables win where set. Keep them separate: the YouTube
# problem wants a Google account and the Instagram one wants an Instagram
# account, and handing either site the other's cookie jar is worse than
# handing it none.
# DBOT_COOKIES_FILE=/data/cookies.txt          # every site, the fallback
# DBOT_IG_COOKIES_FILE=/data/instagram.txt
# DBOT_YT_COOKIES_FILE=/data/youtube.txt
# DBOT_TT_COOKIES_FILE=/data/tiktok.txt
# DBOT_TW_COOKIES_FILE=/data/twitter.txt
# DBOT_RD_COOKIES_FILE=/data/reddit.txt
# DBOT_PROXY=http://user:pass@host:port        # every site, the fallback
# DBOT_IG_PROXY=
# DBOT_YT_PROXY=
# DBOT_TT_PROXY=
# DBOT_TW_PROXY=
# DBOT_RD_PROXY=
#
# Which of YouTube's own clients yt-dlp pretends to be. These are gated
# differently and the gating moves; worth revisiting whenever YouTube
# downloads start failing.
# DBOT_YT_PLAYER_CLIENTS=tv,web_safari,android_vr,web

# --- flood control (shared_features.py, every public bot) ---
# A ceiling on how many updates one person may cost the bot in a rolling
# minute, checked before any handler runs. Telegram limits what a bot SENDS
# and nothing about what it receives, so without this one script can keep a
# container and a shared database busy for as long as it likes. Set high
# enough that a fast typist, an album and a run of button taps all pass --
# it is aimed at a loop, not at a hurry. 0 turns it off; the owner
# (*_ADMIN_ID) is always exempt.
# FLOOD_UPDATES_PER_MINUTE=40
#
# How often somebody over the ceiling is told so. A gate that answers every
# refused message turns an incoming flood into an outgoing one.
# FLOOD_REMIND_SECONDS=60
